<Window x:Class="Elinor.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Elinor" Icon="/Elinor;component/Images/mainicon.png"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" Topmost="True" ShowInTaskbar="True"
        MouseLeftButtonDown="DragWindow" KeyDown="WindowKeyDown">
    <Window.Resources>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Price" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Click to copy" />
        </Style>
    </Window.Resources>

    <Border x:Name="brdRoot" CornerRadius="8" BorderThickness="2" Padding="12,6,8,10" Width="300"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="28" />
                <RowDefinition Height="28" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" x:Name="lblItemName" Text="No item selected" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                <Button Style="{StaticResource IconButton}" Click="BtnExpandClick" ToolTip="Back to full window (Esc)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE740;" FontSize="12" />
                </Button>
                <Button Style="{StaticResource IconButton}" Click="BtnCloseClick" ToolTip="Exit Elinor">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="12" />
                </Button>
            </StackPanel>

            <StackPanel Grid.Row="1" x:Name="pnlSellMode" Orientation="Horizontal" Background="Transparent" Cursor="Hand"
                        MouseLeftButtonUp="SellModeClick">
                <TextBlock x:Name="lblSellMode" Text="Sell" Style="{StaticResource Label}" />
                <TextBlock x:Name="icoSellCopy" Style="{StaticResource Glyph}" Text="&#xE8C8;" FontSize="12" Margin="6,0,0,0"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed" />
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="lblSell" Text="-" Style="{StaticResource Price}"
                       MouseLeftButtonUp="LblSellClick" Margin="0,0,4,0" />
            <StackPanel Grid.Row="2" x:Name="pnlBuyMode" Orientation="Horizontal" Background="Transparent" Cursor="Hand"
                        MouseLeftButtonUp="BuyModeClick">
                <TextBlock x:Name="lblBuyMode" Text="Buy" Style="{StaticResource Label}" />
                <TextBlock x:Name="icoBuyCopy" Style="{StaticResource Glyph}" Text="&#xE8C8;" FontSize="12" Margin="6,0,0,0"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed" />
            </StackPanel>
            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" x:Name="lblBuy" Text="-" Style="{StaticResource Price}"
                       MouseLeftButtonUp="LblBuyClick" Margin="0,0,4,0" />

            <TextBlock Grid.Row="3" Text="Margin" Style="{StaticResource Label}" />
            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
                <TextBlock x:Name="tbCopyStatus" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,10,0"
                           ToolTip="Auto copy status" />
                <TextBlock x:Name="lblMargin" Text="-" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
