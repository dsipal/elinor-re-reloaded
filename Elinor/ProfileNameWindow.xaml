<Window x:Class="Elinor.ProfileNameWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="New profile"
        Width="400" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Loaded="WindowLoaded" Icon="/Elinor;component/Images/mainicon.png" KeyDown="WindowKeyDown">
    <StackPanel Margin="20">
        <TextBlock Text="Profile name" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBox x:Name="tbName" TextChanged="TbNameTextChanged" />
        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="For example the character name. Each profile keeps its own skills, fees and ranges." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnOk" Content="Create" MinWidth="90" IsEnabled="False"
                    Style="{DynamicResource AccentButtonStyle}" Click="BtnOkClick" />
            <Button x:Name="btnCancel" Content="Cancel" MinWidth="90" Margin="8,0,0,0" Click="BtnCancelClick" />
        </StackPanel>
    </StackPanel>
</Window>
